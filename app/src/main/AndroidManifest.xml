<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
 <application android:label="Tulip VPN" android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
  <activity android:name=".MainActivity" android:exported="true">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <service android:name=".TulipVpnService" android:exported="false" android:permission="android.permission.BIND_VPN_SERVICE">
   <intent-filter><action android:name="android.net.VpnService"/></intent-filter>
  </service>
 </application>
</manifest>
